# Copy to .env for local dev:  cp .env.example .env
# Never commit the real .env.

# Used to sign JWT auth tokens too — set a strong value in production.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
# Local default assumes Postgres running on your machine.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/digital_nalanda

# --- CORS: allow the Next.js dev server ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- OPTIONAL: Redis / Celery (leave commented for simple local dev) ---
# Only needed once you install celery+redis and run background jobs.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
