# Copy to .env for local dev:  cp .env.example .env
# Never commit the real .env.

# Used to sign JWT auth tokens too — set a strong value in production.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
# Local default assumes Postgres running on your machine.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/digital_nalanda

# --- CORS: allow the Next.js dev server ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public site URL (certificate verification links / QR codes)
FRONTEND_URL=http://localhost:3000

# --- OPTIONAL: Redis / Celery (leave commented for simple local dev) ---
# Only needed once you install celery+redis and run background jobs.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0

# Optional: Google Gemini AI assistant (leave blank to use template fallback)
# GEMINI_API_KEY=your-key-here

# --- Production hardening (REQUIRED when DJANGO_DEBUG=False) ---
# Comma-separated https origins of the deployed frontend/site (CSRF).
# CSRF_TRUSTED_ORIGINS=https://your-app.ondigitalocean.app

# --- DigitalOcean Spaces (durable media/certificates) ---
# USE_SPACES=True
# SPACES_KEY=your-spaces-access-key
# SPACES_SECRET=your-spaces-secret
# SPACES_BUCKET=digital-nalanda
# SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
# SPACES_REGION=blr1

# --- Email (transactional). Default prints to console; set SMTP for real sends. ---
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Digital Nalanda <no-reply@digitalnalanda.org>
